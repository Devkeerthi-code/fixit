{
  "name": "fixit-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "dev:demo": "vite --mode demo",
    "build:demo": "tsc --noEmit && vite build --mode demo && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "5.2.6",
    "@fontsource-variable/playfair-display": "5.2.6",
    "@hookform/resolvers": "5.2.2",
    "@tanstack/react-query": "5.85.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.92.0",
    "react-router-dom": "6.30.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "10.4.21",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "msw": "2.10.5",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "typescript-eslint": "8.40.0",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
