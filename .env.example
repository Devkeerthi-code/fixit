# Copy to .env (git-ignored) and fill in. The backend reads ../.env when run with ./mvnw spring-boot:run.

# Neon connection string as Neon shows it (kept for reference / psql). Not read by the app directly.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# What Spring actually uses: the JDBC form of the same connection, plus user and password separately.
# Use Neon's direct host (without "-pooler") because Flyway migrations don't work through PgBouncer.
DB_URL=jdbc:postgresql://HOST.neon.tech/neondb?sslmode=require&channelBinding=require
DB_USERNAME=neondb_owner
DB_PASSWORD=change-me

# Signs access tokens (HS256). At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated emails that get the platform admin role (usage stats across all hostels).
ADMIN_EMAILS=you@example.com

# true in production (HTTPS only cookies). false for http://localhost.
COOKIE_SECURE=false

# Frontend origin allowed by CORS in local dev (production is same-origin through the Vercel rewrite).
APP_ORIGIN=http://localhost:3000

# Optional: SLA job interval in ms (default 300000 = 5 min) and DB pool size (default 5).
# SLA_JOB_DELAY_MS=300000
# DB_POOL_SIZE=5
